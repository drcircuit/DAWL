FROM localhost/hypertrix-profiles:v3 AS consensus
FROM localhost/hypertrix-training-runtime:v1
USER root
ENV PYTHONPATH=/app/src
COPY --from=consensus /usr/local/bin/cometbft /usr/local/bin/dawl-consensus /usr/local/bin/
COPY src ./src
COPY scripts ./scripts
COPY dawl_cluster.py dawl_profiles.py dawl_collaboration.py ./
COPY artifacts/check-certificate /usr/local/bin/check-certificate
USER 1000:1000
ENTRYPOINT ["python", "-P", "-m", "dawl_training.oracle"]
