FROM localhost/hypertrix-o200k-gpu:v1
USER root
RUN python -m pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
RUN python -m pip install --no-cache-dir transformers==5.19.0 safetensors==0.8.0 tokenizers==0.23.3
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 CUBLAS_WORKSPACE_CONFIG=:4096:8
ENV OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
USER 1000:1000
